<style>
    /* Dot-grid classroom pinboard background */
    .classroom-dots {
      background-color: #faf8ff;
      background-image: radial-gradient(#c4c5d7 1px, transparent 1px);
      background-size: 24px 24px;
    }
    
    /* Tactile frosted tape strip */
    .washi-tape {
      width: 56px;
      height: 16px;
      background: rgba(255, 255, 255, 0.72);
      backdrop-filter: blur(2px);
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
      border-left: 2px dashed rgba(180, 185, 205, 0.5);
      border-right: 2px dashed rgba(180, 185, 205, 0.5);
    }

    /* Subtle paper card shadow */
    .sticky-shadow {
      box-shadow: 0 4px 16px -2px rgba(21, 27, 42, 0.08), 0 2px 6px -1px rgba(21, 27, 42, 0.04);
    }
    .sticky-shadow-hover:hover {
      box-shadow: 0 14px 28px -6px rgba(21, 27, 42, 0.12), 0 6px 12px -3px rgba(21, 27, 42, 0.06);
    }

    /* Subtle tilts with spring reset on hover */
    .tilt-left { transform: rotate(-0.9deg); transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.22s ease; }
    .tilt-right { transform: rotate(1.1deg); transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.22s ease; }
    .tilt-slight-left { transform: rotate(-0.5deg); transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.22s ease; }
    .tilt-slight-right { transform: rotate(0.8deg); transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.22s ease; }
    
    .tilt-left:hover, .tilt-right:hover, .tilt-slight-left:hover, .tilt-slight-right:hover {
      transform: rotate(0deg) translateY(-4px);
    }
  </style>
