# Dependencies
node_modules/
.pnp
.pnp.js

# Production build outputs
dist/
build/
out/

# Environment and secrets (CRITICAL: Never commit to Git)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!.env.production.example

# SSL / TLS certificates and private keys
certs/*
!certs/.gitkeep
*.pem
*.crt
*.key

# Encrypted User Uploads & Runtime Session Storage
EncryptedUploads/*
!EncryptedUploads/.gitkeep

# Database binary and runtime snapshots
database/*.sqlite*
database/*.db
database/*.json
!database/init-databases.sql

# Logs and runtime diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun.lockb.bak

# OS generated files
.DS_Store
Thumbs.db

# IDE and Editor configs
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
