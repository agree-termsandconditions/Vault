# ==============================================================================
# Campus Multi-Container Production Environment Configuration
# Copy this file to .env and configure secrets before production startup
# ==============================================================================

# 1. Database Security
# Set a strong, randomly generated alphanumeric password for the PostgreSQL engine
DB_PASSWORD=campus_secure_vault_2026

# 2. Session Security
# 64-character random hex string for HMAC session token signing
SESSION_SECRET=c6f4a8e2910d5b73e8f1c4a920b7d3e5f8a1c9e2b4d7f0a3c5e8b1d4f7a0c3e6

# 3. Second App (Timed Internet Access & Gateway Controller)
# Change the default admin password from 'admin123' to a high-entropy passphrase
ADMIN_PASSWORD=change_this_to_a_strong_admin_passphrase!

# 4. AI Assistant (Gemini API)
# Leave empty if AI chat is currently disabled; fill in when ready to enable
GEMINI_API_KEY=

# 5. Domain / Production Host URL
APP_URL=https://akish.online

# 6. Second App SSH Configuration
CLIENT_SSH_USER=teachnext
SIMULATION_FALLBACK=false
